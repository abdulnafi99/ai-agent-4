# ---------------------------------------------------------------------------
# NAFI AI OFFICE — server configuration. Copy to .env and fill in.
# Secrets stay on the server. Nothing here is ever sent to the browser except
# FIREBASE_WEB_CONFIG, which is public by design.
# ---------------------------------------------------------------------------

PORT=8080

# ---- AI provider (pick one; first key found wins, or force with AI_PROVIDER)
# AI_PROVIDER=anthropic   # anthropic | openai | gemini | demo
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional per-agent AI provider (each needs its key above). Example:
# AGENT_PROVIDER_RESEARCH=gemini
# AGENT_PROVIDER_SOCIAL=openai
# AGENT_PROVIDER_CEO=
# AGENT_PROVIDER_DEVELOPMENT=
# AGENT_PROVIDER_SECURITY=

# Optional per-agent model overrides
# AGENT_MODEL_CEO=
# AGENT_MODEL_RESEARCH=
# AGENT_MODEL_DEVELOPMENT=
# AGENT_MODEL_SOCIAL=
# AGENT_MODEL_SECURITY=

# ---- Storage: "rtdb" (Firebase Realtime Database), "firestore" or "file" (data/office.json)
# Defaults to the Realtime Database whenever FIREBASE_SERVICE_ACCOUNT is set.
# The service account key comes from Firebase console -> Project settings -> Service accounts
# -> Generate new private key. Paste the whole JSON (one line) or a path to the file. Keep it secret.
# FIREBASE_SERVICE_ACCOUNT=
# STORAGE=rtdb
# FIREBASE_DATABASE_URL=https://ai-agent-25973-default-rtdb.asia-southeast1.firebasedatabase.app
# The project's public web config is built in; override it with:
# FIREBASE_WEB_CONFIG={"apiKey":"...","projectId":"...","databaseURL":"..."}
# FIREBASE_ANALYTICS=false   # turn off Firebase Analytics in the browser

# ---- Owner authentication: AUTH_MODE = key | firebase | none
# Default: "key" when OWNER_ACCESS_KEY is set, else "firebase" when FIREBASE_WEB_CONFIG is set, else none (dev only).
# OWNER_ACCESS_KEY=change-me-to-a-long-random-string
# AUTH_MODE=firebase
# OWNER_EMAILS=you@example.com   # with AUTH_MODE=firebase: who may sign in

# ---- Autonomy safety rails
# MAX_TURNS_PER_CHAIN=24      # agent turns allowed per owner instruction before pausing
# MAX_CONCURRENT_AGENTS=2     # agents thinking at the same time
# TURN_DELAY_MS=900
